# Copy this to .env and fill in what you have. Everything works without keys:
# speech recognition falls back to Whisper (offline) and the voice to macOS "say".
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ASR_PROVIDER=auto        # deepgram | whisper | auto
TTS_PROVIDER=auto        # elevenlabs | local | none | auto
NOISY_DB=-42
MIN_SNR_DB=15
